{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Allusion",
  "version": "1.0.0-rc.10",
  "identifier": "com.allusion-app.allusion",
  "build": {
    "frontendDist": "../build",
    "beforeBuildCommand": "yarn production"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Allusion",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "devtools": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": [
            "$APPDATA/**/*",
            "$APPCACHE/**/*",
            "$CACHE/**/*",
            "$RESOURCE/**/*",
            "$TEMP/Allusion/**/*"
          ]
        }
      },
      "csp": {
        "default-src": "'self'",
        "script-src": ["'self'", "'wasm-unsafe-eval'"],
        "connect-src": ["'self'", "ipc:", "http://ipc.localhost", "http://asset.localhost", "https://asset.localhost", "asset:", "blob:", "data:"],
        "img-src": ["'self'", "asset:", "http://asset.localhost", "https://asset.localhost", "blob:", "data:", "file:"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "font-src": ["'self'", "data:"],
        "worker-src": ["'self'", "blob:"],
        "child-src": ["'self'", "blob:"],
        "media-src": ["'self'", "blob:", "file:"],
        "frame-src": ["'self'"]
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": ["'self'", "'wasm-unsafe-eval'"],
        "connect-src": ["'self'", "ipc:", "http://ipc.localhost", "http://asset.localhost", "https://asset.localhost", "asset:", "blob:", "data:", "ws:"],
        "img-src": ["'self'", "asset:", "http://asset.localhost", "https://asset.localhost", "blob:", "data:", "file:"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "font-src": ["'self'", "data:"],
        "worker-src": ["'self'", "blob:"],
        "child-src": ["'self'", "blob:"],
        "media-src": ["'self'", "blob:", "file:"],
        "frame-src": ["'self'"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
